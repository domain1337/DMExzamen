<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Background="#D2F6E7">
            <Label Grid.Row="0" Content="Магазин Одежды"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32"></Label>

            <Image Source="/Resources/Чудо обувь.png" HorizontalAlignment="Left"
                   VerticalAlignment="Center" Margin="300,0,0,0"></Image>
        </Grid>
        <Frame Grid.Row="1" x:Name="MainFrame"
               NavigationUIVisibility="Hidden"></Frame>
    </Grid>
</Window>
